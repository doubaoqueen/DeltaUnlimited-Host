{
  "name": "进场链路 v7（switch_screen 一次识别查表分流）",
  "说明": "结构优化版：主循环 = switch_screen 一次截图+识别后按表分流（12 个已知界面 + default 兜底），各分支动作完成后统一跳回主循环（汇聚）。广场(常态)→点配装→裸装鉴别(未装配≥4)→制式套装→均衡→确认配装→出发；广场(首次)→行前备战→轮询等待地图池淡入；部署面板→开始行动（裸装可跳过配装界面直进入局提醒）；入局提醒→未转移行检查→仍要继续；匹配→自动选干员（未配置保持当前；15s 倒计时自动开局）→结束；未知界面→Tab 兜底（熔断 max_loops=3）。所有失败软跳转+mark_unknown 留证+人工确认。",
  "steps": [
    { "id": "detect_start", "op": "switch_screen", "max_loops": 3, "default": "unknown_tab",
      "branches": {
        "plaza_first": "prep", "plaza_ready": "do_loadout", "space_continue": "skip_overlay",
        "mode_select": "pick_mode", "map_select": "start_action", "map_pool": "pick_zerodam",
        "loadout": "check_loadout", "deploy_reminder": "reminder_check", "matching": "wait_match",
        "char_select": "pick_operator", "settlement": "settlement_wait", "preset_select": "preset_apply" } },
    { "id": "unknown_tab", "op": "key", "key": "tab", "wait_ms": 1200, "capture": "after_tab" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "skip_overlay", "op": "key", "key": "space", "wait_ms": 1200 },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "settlement_wait", "op": "key", "key": "space", "wait_ms": 1500, "capture": "after_settle_space" },
    { "op": "switch_screen", "default": "detect_start", "branches": { "settlement": "settlement_manual" } },
    { "id": "settlement_manual", "op": "mark_unknown", "message": "结算画面按空格后仍未关闭（可能还需再按一次），人工处理后回车重判" },
    { "op": "jump", "jump_to": "settlement_wait" },
    { "id": "safe_box_manual", "op": "mark_unknown", "message": "入局提醒中含“安全箱内有道具未转移”：可点击该行进仓库转移，或确认不影响后回车重判（自动转移留待撤离链路阶段实现）" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "pick_mode", "op": "click_element", "element": "wf_mode_card", "wait_ms": 1500, "capture": "after_mode_click" },
    { "op": "wait_screen", "screen": "mode_select", "absent": true, "timeout_ms": 5000, "jump_to": "mode_click_fail" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "mode_click_fail", "op": "mark_unknown", "message": "点击烽火地带卡片后模式选择界面未消失，已标记截图。人工处理后回车重判" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "prep", "op": "click_element", "element": "plaza_prep_button", "wait_ms": 1500, "capture": "after_prep" },
    { "op": "wait_screen", "screen": "map_pool", "timeout_ms": 6000, "jump_to": "after_prep_check" },
    { "op": "jump", "jump_to": "pick_zerodam" },
    { "id": "after_prep_check", "op": "switch_screen", "default": "prep_unknown",
      "branches": { "map_select": "start_action", "map_pool": "pick_zerodam" } },
    { "id": "prep_unknown", "op": "mark_unknown", "message": "点击行前备战后进入未知界面，已标记截图。人工处理后回车重判" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "pick_zerodam", "op": "click_element", "element": "zerodam_card", "expect_screen": "map_select", "timeout_ms": 8000, "retries": 1, "wait_ms": 1500, "capture": "after_pick", "jump_to": "recheck_pick" },
    { "id": "recheck_pick", "op": "switch_screen", "default": "detect_start",
      "branches": { "map_select": "start_action", "map_pool": "recheck_pick_manual" } },
    { "id": "recheck_pick_manual", "op": "mark_unknown", "message": "点零号大坝后仍未进入部署面板（若停在“常规行动”选择，请人工点选），已标记截图。人工处理后回车重试" },
    { "op": "jump", "jump_to": "pick_zerodam" },
    { "id": "start_action", "op": "click_element", "element": "start_action_button", "expect_screen": "loadout", "timeout_ms": 10000, "wait_ms": 1500, "capture": "loadout", "jump_to": "start_action_manual" },
    { "op": "jump", "jump_to": "check_loadout" },
    { "id": "do_loadout", "op": "click_element", "element": "plaza_loadout_button", "expect_screen": "loadout", "timeout_ms": 8000, "wait_ms": 1500, "capture": "loadout_from_plaza", "jump_to": "do_loadout_fail" },
    { "op": "jump", "jump_to": "check_loadout" },
    { "id": "do_loadout_fail", "op": "mark_unknown", "message": "点击配装按钮后未进入配装界面，已标记截图。人工处理后回车重判" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "check_loadout", "op": "if_ocr", "keywords": ["未装配"], "min_count": 4, "jump_to": "apply_standard_set" },
    { "op": "jump", "jump_to": "confirm_loadout" },
    { "id": "apply_standard_set", "op": "click_element", "element": "standard_set_card", "expect_screen": "preset_select", "timeout_ms": 8000, "wait_ms": 1500, "capture": "preset_select", "jump_to": "preset_entry_fail" },
    { "id": "preset_apply", "op": "click_element", "element": "preset_balanced_button", "expect_screen": "loadout", "timeout_ms": 2500, "wait_ms": 1200, "capture": "after_preset_apply", "jump_to": "preset_apply_fail" },
    { "op": "jump", "jump_to": "confirm_loadout" },
    { "id": "preset_entry_fail", "op": "mark_unknown", "message": "点击制式套装后未进入装备预设界面，已标记截图。人工处理后回车重判" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "preset_apply_fail", "op": "switch_screen", "default": "detect_start",
      "branches": { "loadout": "confirm_loadout", "preset_select": "preset_apply_manual" } },
    { "id": "preset_apply_manual", "op": "mark_unknown", "message": "点击均衡卡消耗按钮后未回到配装界面（可能制式装备券不足或不符合地图/等级/模式规则；顶部提示约1.5秒已消失）。人工处理后回车重判" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "confirm_loadout", "op": "click_element", "element": "confirm_loadout_button", "wait_ms": 1500, "capture": "after_confirm" },
    { "op": "switch_screen", "default": "detect_start",
      "branches": { "deploy_reminder": "reminder_check", "plaza_ready": "depart", "loadout": "confirm_loadout_fail" } },
    { "id": "confirm_loadout_fail", "op": "mark_unknown", "message": "点击确认配装后仍在配装界面（按钮未命中或出现弹窗），已标记截图。人工处理后回车重判" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "start_action_manual", "op": "switch_screen", "default": "start_unknown",
      "branches": { "deploy_reminder": "reminder_check", "plaza_ready": "depart", "loadout": "check_loadout", "map_select": "start_action" } },
    { "id": "start_unknown", "op": "mark_unknown", "message": "点击开始行动后未进入配装界面（裸装时可能直接进入局提醒），已标记截图。人工处理后回车重判" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "depart", "op": "click_element", "element": "depart_button", "expect_screen": "matching", "timeout_ms": 8000, "wait_ms": 1500, "capture": "matching", "jump_to": "depart_manual" },
    { "op": "jump", "jump_to": "wait_match" },
    { "id": "reminder_check", "op": "if_ocr", "keywords": ["未转移"], "jump_to": "safe_box_manual" },
    { "op": "jump", "jump_to": "reminder" },
    { "id": "reminder", "op": "click_element", "element": "continue_anyway_button", "expect_screen": "plaza_ready", "timeout_ms": 8000, "wait_ms": 1500, "capture": "after_reminder", "jump_to": "reminder_manual" },
    { "op": "jump", "jump_to": "depart" },
    { "id": "depart_manual", "op": "mark_unknown", "message": "点击出发后未进入匹配界面，已标记截图。人工处理后回车重试" },
    { "op": "jump", "jump_to": "depart" },
    { "id": "reminder_manual", "op": "mark_unknown", "message": "点击仍要继续后未回到广场，已标记截图。人工处理后回车重试" },
    { "op": "jump", "jump_to": "reminder" },
    { "id": "wait_match", "op": "wait_screen", "screen": "char_select", "timeout_ms": 90000, "jump_to": "after_match_check" },
    { "op": "jump", "jump_to": "pick_operator" },
    { "id": "after_match_check", "op": "switch_screen", "default": "match_fail",
      "branches": { "char_select": "pick_operator", "matching": "wait_match" } },
    { "id": "pick_operator", "op": "pick_operator" },
    { "op": "jump", "jump_to": "done" },
    { "id": "match_fail", "op": "pause", "message": "匹配等待超时（人工处理，可手动点出发后重跑链路）" },
    { "op": "jump", "jump_to": "wait_match" },
    { "id": "done", "op": "detect" },
    { "op": "pause", "message": "进场链路结束（已选干员等待自动开局，或已进入对局）" }
  ]
}
