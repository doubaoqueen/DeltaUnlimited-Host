{
  "name": "进场链路 v3（常态：非初次进入）",
  "说明": "自动分支：识别当前界面——已在广场(plaza_ready)→直接点出发；否则(特勤处)按 Tab 后点出发。点击后等待匹配结束（干员选择界面出现，最长 4 分钟），超时人工兜底。",
  "steps": [
    { "id": "detect_start", "op": "detect" },
    { "id": "branch_ready", "op": "if_screen", "screen": "plaza_ready", "jump_to": "depart" },
    { "id": "tab_step", "op": "key", "key": "tab", "wait_ms": 1500, "capture": "after_tab" },
    { "op": "detect" },
    { "op": "if_screen", "screen": "plaza_ready", "jump_to": "depart" },
    { "op": "pause", "message": "未识别出广场界面（可能有公告/广告未关闭或处于未知界面），人工处理后回车" },
    { "op": "jump", "jump_to": "end" },
    { "id": "depart", "op": "click_element", "element": "depart_button", "wait_ms": 2000, "capture": "matching" },
    { "op": "detect" },
    { "id": "wait_match", "op": "wait_screen", "screen": "char_select", "timeout_ms": 240000, "jump_to": "match_fail" },
    { "op": "jump", "jump_to": "done" },
    { "id": "match_fail", "op": "pause", "message": "匹配等待超时或未进入干员选择界面（人工检查，可手动点出发后重新运行本链路）" },
    { "op": "jump", "jump_to": "end" },
    { "id": "done", "op": "detect" },
    { "op": "pause", "message": "已到干员选择界面 —— 进场链路结束" },
    { "id": "end", "op": "pause", "message": "链路结束" }
  ]
}
