{
  "name": "进场链路 v6（全界面自动分支 + 制式套装配装）",
  "说明": "启动即识别，自动分支接续：广场(配装|出发)→点配装→(裸装鉴别:未装配≥4才套预设)制式套装→均衡→确认配装→出发（常态，每局自动套预设）；广场(行前备战)→选图（轮询等待地图池淡入）；地图池→点零号大坝；部署面板→开始行动（裸装可能跳过配装界面直进入局提醒，失败分支自动鉴别）；配装→鉴别→制式套装→均衡→确认配装（确认时才真正扣券）；入局提醒→未转移行检查→仍要继续；匹配中→继续等；干员选择→自动选人（按 operator_presets 配置，未配置保持当前；无出击按钮，15s 倒计时自动开局）→结束；空格弹层→短按空格；模式选择→点烽火地带。特勤处(lobby)识别后走盲按 Tab 切备战（未知界面同样兜底）。click_element 未达预期界面不再硬中止：按 jump_to 软跳转重判/人工确认（证据帧照存）。所有未知界面 mark_unknown 截图+词表留证并人工确认。",
  "steps": [
    { "id": "detect_start", "op": "detect" },
    { "op": "if_screen", "screen": "plaza_first", "jump_to": "prep" },
    { "op": "if_screen", "screen": "plaza_ready", "jump_to": "do_loadout" },
    { "op": "if_screen", "screen": "space_continue", "jump_to": "skip_overlay" },
    { "op": "if_screen", "screen": "mode_select", "jump_to": "pick_mode" },
    { "op": "if_screen", "screen": "map_select", "jump_to": "start_action" },
    { "op": "if_screen", "screen": "map_pool", "jump_to": "pick_zerodam" },
    { "op": "if_screen", "screen": "loadout", "jump_to": "check_loadout" },
    { "op": "if_screen", "screen": "deploy_reminder", "jump_to": "reminder_check" },
    { "op": "if_screen", "screen": "matching", "jump_to": "wait_match" },
    { "op": "if_screen", "screen": "char_select", "jump_to": "pick_operator" },
    { "op": "if_screen", "screen": "settlement", "jump_to": "settlement_wait" },
    { "op": "if_screen", "screen": "preset_select", "jump_to": "preset_apply" },
    { "op": "key", "key": "tab", "wait_ms": 1500, "capture": "after_tab" },
    { "op": "detect" },
    { "op": "if_screen", "screen": "plaza_first", "jump_to": "prep" },
    { "op": "if_screen", "screen": "plaza_ready", "jump_to": "do_loadout" },
    { "op": "if_screen", "screen": "space_continue", "jump_to": "skip_overlay" },
    { "op": "if_screen", "screen": "mode_select", "jump_to": "pick_mode" },
    { "op": "if_screen", "screen": "map_select", "jump_to": "start_action" },
    { "op": "if_screen", "screen": "map_pool", "jump_to": "pick_zerodam" },
    { "op": "if_screen", "screen": "loadout", "jump_to": "check_loadout" },
    { "op": "if_screen", "screen": "deploy_reminder", "jump_to": "reminder_check" },
    { "op": "if_screen", "screen": "matching", "jump_to": "wait_match" },
    { "op": "if_screen", "screen": "char_select", "jump_to": "pick_operator" },
    { "op": "if_screen", "screen": "settlement", "jump_to": "settlement_wait" },
    { "op": "if_screen", "screen": "preset_select", "jump_to": "preset_apply" },
    { "op": "mark_unknown", "message": "两次识别仍未到已知界面（若为特勤处：Tab 已尝试切换未生效，请确认游戏窗口在最前）。人工处理后回车重判" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "skip_overlay", "op": "key", "key": "space", "wait_ms": 1500 },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "settlement_wait", "op": "key", "key": "space", "wait_ms": 1500, "capture": "after_settle_space" },
    { "op": "detect" },
    { "op": "if_screen", "screen": "settlement", "jump_to": "settlement_manual" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "settlement_manual", "op": "mark_unknown", "message": "结算画面按空格后仍未关闭（可能还需再按一次），人工处理后回车重判" },
    { "op": "jump", "jump_to": "settlement_wait" },
    { "id": "safe_box_manual", "op": "mark_unknown", "message": "入局提醒中含“安全箱内有道具未转移”：可点击该行进仓库转移，或确认不影响后回车重判（自动转移留待撤离链路阶段实现）" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "pick_mode", "op": "click_element", "element": "wf_mode_card", "wait_ms": 2000, "capture": "after_mode_click" },
    { "op": "wait_screen", "screen": "mode_select", "absent": true, "timeout_ms": 5000, "jump_to": "mode_click_fail" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "mode_click_fail", "op": "mark_unknown", "message": "点击烽火地带卡片后模式选择界面未消失，已标记截图。人工处理后回车重判" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "prep", "op": "click_element", "element": "plaza_prep_button", "wait_ms": 2000, "capture": "after_prep" },
    { "op": "wait_screen", "screen": "map_pool", "timeout_ms": 6000, "jump_to": "after_prep_check" },
    { "op": "jump", "jump_to": "pick_zerodam" },
    { "id": "after_prep_check", "op": "detect" },
    { "op": "if_screen", "screen": "map_select", "jump_to": "start_action" },
    { "op": "if_screen", "screen": "map_pool", "jump_to": "pick_zerodam" },
    { "op": "mark_unknown", "message": "点击行前备战后进入未知界面，已标记截图。人工处理后回车重判" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "pick_zerodam", "op": "click_element", "element": "zerodam_card", "expect_screen": "map_select", "timeout_ms": 8000, "retries": 1, "wait_ms": 2000, "capture": "after_pick", "jump_to": "recheck_pick" },
    { "id": "recheck_pick", "op": "detect" },
    { "op": "if_screen", "screen": "map_select", "jump_to": "start_action" },
    { "op": "if_screen", "screen": "map_pool", "jump_to": "recheck_pick_manual" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "recheck_pick_manual", "op": "mark_unknown", "message": "点零号大坝后仍未进入部署面板（若停在“常规行动”选择，请人工点选），已标记截图。人工处理后回车重试" },
    { "op": "jump", "jump_to": "pick_zerodam" },
    { "id": "start_action", "op": "click_element", "element": "start_action_button", "expect_screen": "loadout", "timeout_ms": 10000, "wait_ms": 2000, "capture": "loadout", "jump_to": "start_action_manual" },
    { "op": "jump", "jump_to": "check_loadout" },
    { "id": "do_loadout", "op": "click_element", "element": "plaza_loadout_button", "expect_screen": "loadout", "timeout_ms": 8000, "wait_ms": 2000, "capture": "loadout_from_plaza", "jump_to": "do_loadout_fail" },
    { "op": "jump", "jump_to": "check_loadout" },
    { "id": "do_loadout_fail", "op": "mark_unknown", "message": "点击配装按钮后未进入配装界面，已标记截图。人工处理后回车重判" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "check_loadout", "op": "if_ocr", "keywords": ["未装配"], "min_count": 4, "jump_to": "apply_standard_set" },
    { "op": "jump", "jump_to": "confirm_loadout" },
    { "id": "apply_standard_set", "op": "click_element", "element": "standard_set_card", "expect_screen": "preset_select", "timeout_ms": 8000, "wait_ms": 2000, "capture": "preset_select", "jump_to": "preset_entry_fail" },
    { "id": "preset_apply", "op": "click_element", "element": "preset_balanced_button", "expect_screen": "loadout", "timeout_ms": 2500, "wait_ms": 1500, "capture": "after_preset_apply", "jump_to": "preset_apply_fail" },
    { "op": "jump", "jump_to": "confirm_loadout" },
    { "id": "preset_entry_fail", "op": "mark_unknown", "message": "点击制式套装后未进入装备预设界面，已标记截图。人工处理后回车重判" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "preset_apply_fail", "op": "detect" },
    { "op": "if_screen", "screen": "loadout", "jump_to": "confirm_loadout" },
    { "op": "if_screen", "screen": "preset_select", "jump_to": "preset_apply_manual" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "preset_apply_manual", "op": "mark_unknown", "message": "点击均衡卡消耗按钮后未回到配装界面（可能制式装备券不足或不符合地图/等级/模式规则；顶部提示约1.5秒已消失）。人工处理后回车重判" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "confirm_loadout", "op": "click_element", "element": "confirm_loadout_button", "wait_ms": 2500, "capture": "after_confirm" },
    { "op": "detect" },
    { "op": "if_screen", "screen": "deploy_reminder", "jump_to": "reminder_check" },
    { "op": "if_screen", "screen": "plaza_ready", "jump_to": "depart" },
    { "op": "if_screen", "screen": "loadout", "jump_to": "confirm_loadout_fail" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "confirm_loadout_fail", "op": "mark_unknown", "message": "点击确认配装后仍在配装界面（按钮未命中或出现弹窗），已标记截图。人工处理后回车重判" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "start_action_manual", "op": "detect" },
    { "op": "if_screen", "screen": "deploy_reminder", "jump_to": "reminder_check" },
    { "op": "if_screen", "screen": "plaza_ready", "jump_to": "depart" },
    { "op": "if_screen", "screen": "loadout", "jump_to": "check_loadout" },
    { "op": "if_screen", "screen": "map_select", "jump_to": "start_action" },
    { "op": "mark_unknown", "message": "点击开始行动后未进入配装界面（裸装时可能直接进入局提醒），已标记截图。人工处理后回车重判" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "depart", "op": "click_element", "element": "depart_button", "expect_screen": "matching", "timeout_ms": 8000, "wait_ms": 2000, "capture": "matching", "jump_to": "depart_manual" },
    { "op": "jump", "jump_to": "wait_match" },
    { "id": "reminder_check", "op": "if_ocr", "keywords": ["未转移"], "jump_to": "safe_box_manual" },
    { "op": "jump", "jump_to": "reminder" },
    { "id": "reminder", "op": "click_element", "element": "continue_anyway_button", "expect_screen": "plaza_ready", "timeout_ms": 8000, "wait_ms": 2000, "capture": "after_reminder", "jump_to": "reminder_manual" },
    { "op": "jump", "jump_to": "depart" },
    { "id": "depart_manual", "op": "mark_unknown", "message": "点击出发后未进入匹配界面，已标记截图。人工处理后回车重试" },
    { "op": "jump", "jump_to": "depart" },
    { "id": "reminder_manual", "op": "mark_unknown", "message": "点击仍要继续后未回到广场，已标记截图。人工处理后回车重试" },
    { "op": "jump", "jump_to": "reminder" },
    { "id": "wait_match", "op": "wait_screen", "screen": "char_select", "timeout_ms": 90000, "jump_to": "after_match_check" },
    { "op": "jump", "jump_to": "pick_operator" },
    { "id": "after_match_check", "op": "detect" },
    { "op": "if_screen", "screen": "char_select", "jump_to": "pick_operator" },
    { "op": "if_screen", "screen": "matching", "jump_to": "wait_match" },
    { "op": "jump", "jump_to": "done" },
    { "id": "pick_operator", "op": "pick_operator" },
    { "op": "jump", "jump_to": "done" },
    { "id": "match_fail", "op": "pause", "message": "匹配等待超时（人工处理，可手动点出发后重跑链路）" },
    { "op": "jump", "jump_to": "end" },
    { "id": "done", "op": "detect" },
    { "op": "pause", "message": "进场链路结束（已选干员等待自动开局，或已进入对局）" },
    { "id": "end", "op": "pause", "message": "链路结束" }
  ]
}
