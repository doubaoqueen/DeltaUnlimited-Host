{
  "name": "进场链路 v2.2（初次：状态驱动 + 自动选图 + 空格弹层跳过 + 未知标记）",
  "说明": "启动即识别：广场(配装|出发)→直接出发；广场(行前备战)→直接进场前流程；空格继续弹层(广告/结算等)→短按空格跳过；模式选择→暂停人工点烽火地带(坐标待标定)；其他(特勤处/未知)→按 Tab 后再识别。行前备战→地图池自动点零号大坝卡片(模板)→部署面板→开始行动→确认配装→(入局提醒)仍要继续→出发→等匹配→干员选择。所有未知界面用 mark_unknown 截图+词表留证。",
  "steps": [
    { "id": "detect_start", "op": "detect" },
    { "op": "if_screen", "screen": "plaza_first", "jump_to": "prep" },
    { "op": "if_screen", "screen": "plaza_ready", "jump_to": "depart" },
    { "op": "if_screen", "screen": "space_continue", "jump_to": "skip_overlay" },
    { "op": "if_screen", "screen": "mode_select", "jump_to": "pick_mode" },
    { "op": "key", "key": "tab", "wait_ms": 1500, "capture": "after_tab" },
    { "op": "detect" },
    { "op": "if_screen", "screen": "plaza_first", "jump_to": "prep" },
    { "op": "if_screen", "screen": "plaza_ready", "jump_to": "depart" },
    { "op": "if_screen", "screen": "space_continue", "jump_to": "skip_overlay" },
    { "op": "mark_unknown", "message": "两次识别仍未到广场（可能是公告/广告/其他界面；个别界面需长按空格跳过），已标记截图。人工处理后回车重判" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "skip_overlay", "op": "key", "key": "space", "wait_ms": 1500 },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "pick_mode", "op": "pause", "message": "已识别模式选择界面（自动点击“烽火地带”待卡片坐标标定）。请人工点击“烽火地带”后回车重判" },
    { "op": "jump", "jump_to": "detect_start" },
    { "id": "prep", "op": "click_element", "element": "plaza_prep_button", "wait_ms": 2000, "capture": "after_prep" },
    { "op": "detect" },
    { "op": "if_screen", "screen": "map_select", "jump_to": "start_action" },
    { "op": "if_screen", "screen": "map_pool", "jump_to": "pick_zerodam" },
    { "op": "mark_unknown", "message": "点击行前备战后进入未知界面，已标记截图。人工处理后回车重判" },
    { "op": "jump", "jump_to": "recheck_after_prep" },
    { "id": "pick_zerodam", "op": "click_element", "element": "zerodam_card", "expect_screen": "map_select", "timeout_ms": 8000, "retries": 1, "wait_ms": 2000, "capture": "after_pick" },
    { "id": "recheck_after_prep", "op": "detect" },
    { "op": "if_screen", "screen": "map_select", "jump_to": "start_action" },
    { "op": "mark_unknown", "message": "选图后仍未进入部署面板（若停在模式选择，请人工选“常规行动”），已标记截图。人工处理后回车重试" },
    { "op": "jump", "jump_to": "recheck_after_prep" },
    { "id": "start_action", "op": "click_element", "element": "start_action_button", "expect_screen": "loadout", "timeout_ms": 10000, "wait_ms": 2000, "capture": "loadout" },
    { "op": "click_element", "element": "confirm_loadout_button", "wait_ms": 2500, "capture": "after_confirm" },
    { "op": "detect" },
    { "op": "if_screen", "screen": "deploy_reminder", "jump_to": "reminder" },
    { "id": "depart", "op": "click_element", "element": "depart_button", "expect_screen": "matching", "timeout_ms": 8000, "wait_ms": 2000, "capture": "matching" },
    { "op": "jump", "jump_to": "wait_match" },
    { "id": "reminder", "op": "click_element", "element": "continue_anyway_button", "expect_screen": "plaza_ready", "timeout_ms": 8000, "wait_ms": 2000, "capture": "after_reminder" },
    { "op": "jump", "jump_to": "depart" },
    { "id": "wait_match", "op": "wait_screen", "screen": "char_select", "timeout_ms": 240000, "jump_to": "match_fail" },
    { "op": "jump", "jump_to": "done" },
    { "id": "match_fail", "op": "pause", "message": "匹配等待超时（人工处理，可手动点出发后重跑链路）" },
    { "op": "jump", "jump_to": "end" },
    { "id": "done", "op": "detect" },
    { "op": "pause", "message": "已到干员选择界面 —— 进场链路结束" },
    { "id": "end", "op": "pause", "message": "链路结束" }
  ]
}
