{
  "schema_version": 1,
  "说明": "运行时标定参数：按本机环境与游戏内设置标定。EDPI(鼠标DPI×游戏灵敏度)变化后需重新标定（标定法：反复 turn 1000 0 数 n 次回到原方向，90°px≈250n）。⚠️ 铁律：humanizer 全部参数必须保持随机范围（禁止改为固定值）——轨迹/节奏随机性是拟人化的核心，固定参数会让连续操作变机械",
  "window_keyword": "三角洲行动",
  "px_per_90deg": 4500,
  "poll_interval_ms": 300,
  "poll_interval_note": "等待界面时的轮询间隔（ms）。2026-09-30 由 600 降到 300：等待循环已加'变更门'——先做 1/6 缩略图帧差（约 2ms），画面无变化就跳过整轮识别（Detect≈600-700ms），因此高频轮询不再昂贵；界面出现后的反应延迟随之降到 ~300ms 量级",
  "design_width": 1920,
  "design_height": 1080,
  "ocr_engine": "windows",
  "humanizer": {
    "click_pause_min": 150,
    "click_pause_max": 320,
    "press_hold_min": 100,
    "press_hold_max": 220,
    "key_tap_min": 35,
    "key_tap_max": 90,
    "key_gap_min": 15,
    "key_gap_max": 30,
    "mouse_step_delay_min": 3,
    "mouse_step_delay_max": 11,
    "step_extra_min": 3,
    "step_extra_max": 8,
    "step_jitter_min": 0.8,
    "step_jitter_max": 1.2,
    "hold_jitter_min": 0.92,
    "hold_jitter_max": 1.08,
    "mouse": {
      "min_duration_ms": 250,
      "max_duration_ms": 650,
      "per_pixel_ms": 0.5,
      "step_interval_ms": 12,
      "curvature_max_px": 90,
      "jitter_px": 2,
      "overshoot_probability": 0.18,
      "overshoot_px_min": 5,
      "overshoot_px_max": 22,
      "verify_tolerance_px": 6
    }
  }
}
